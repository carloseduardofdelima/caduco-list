generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id         String    @id @default(cuid())
  igdbId     String?   @unique
  title      String
  coverUrl   String?
  status     Status
  rating     Int?
  playedAt   DateTime?
  notes      String?
  platform   String    @default("PS2")
  tags       String[]  @default([])
  isJapanOnly Boolean   @default(false)
  summary    String?
  storyline  String?
  developer  String?
  publisher  String?
  releaseYear Int?
  screenshots String[]  @default([])
  videoUrl   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum Status {
  PLAYED
  PLAYING
  BACKLOG
}
